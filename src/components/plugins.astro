---
import guideicon from '../assets/guide_icon.svg';
import portalsicon from '../assets/icon-portal.png';
---

<div class="plugins">
    <div class="mt-2">
        <h4>
            Godot C# Plugins
        </h4>
        <p>
            A collection of plugins for the Godot engine.
        </p>
        <div>
            <a href="https://github.com/Phlegmlee/G.U.I.D.E-CSharp" target="_blank">
            <img class="icon" src={guideicon.src}/>
            </a>
			<div>
				<p>G.U.I.D.E. C#</p>
			</div>

            <a href="https://github.com/Phlegmlee/godot-portals-plugin-csharp" target="_blank">
            <img src={portalsicon.src}/>
            </a>
			<div>
				<p>Portals 3D C#</p>
			</div>

        </div>
    </div>
</div>